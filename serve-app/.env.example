# SERVE — backend config. Copy to .env.local and fill in from your Supabase
# project (Project Settings → API). With these set, the app uses real auth +
# a live Postgres backend with realtime sync. Without them, it runs on the
# local store (offline demo) unchanged.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Web Push (optional). Without this, parents still get alerts while SERVE is
# open — they just don't get woken when it's closed.
#
# Generate the pair once:   npx web-push generate-vapid-keys
# The PUBLIC half goes here (it ships in the bundle and is meant to be public).
# The PRIVATE half goes to Supabase, never here:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=
