# SERVE — backend config. Copy to .env.local and fill in from your Supabase
# project (Project Settings → API). With these set, the app uses real auth +
# a live Postgres backend with realtime sync. Without them, it runs on the
# local store (offline demo) unchanged.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
